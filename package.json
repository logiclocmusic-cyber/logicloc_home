{
  "name": "family-ledger",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "start:api": "NODE_ENV=production SERVE_STATIC=false node server/index.js",
    "preview": "npm run build && npm run start",
    "import-backup": "node scripts/import-backup.mjs",
    "pull-from-railway": "node scripts/pull-from-railway.mjs",
    "push-to-railway": "node scripts/push-to-railway.mjs",
    "reset-admin-password": "node scripts/reset-admin-password.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}
