# 复制为 .env 后填入密钥（docker compose 会读取）
# cp .env.nas.example .env
# 或运行: DEEPSEEK_VISION_API_KEY=sk-xxx NAS_PASS=密码 ./scripts/setup-nas-ai-env.sh

PORT=3080

# 硅基流动 — 发票图片/PDF 识别（必填，行首不要加 #）
# 密钥: https://cloud.siliconflow.cn/account/ak
DEEPSEEK_VISION_API_BASE=https://api.siliconflow.cn
DEEPSEEK_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
DEEPSEEK_VISION_API_KEY=

# 可选：Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# 可选：DeepSeek 官方文本 API
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
