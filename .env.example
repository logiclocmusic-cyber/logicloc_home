# 本地开发（可选，默认走 Vite 代理，无需设置）
# VITE_API_BASE=http://localhost:3001

# Railway 后端
# NODE_ENV=production
# SERVE_STATIC=false
# FRONTEND_URL=https://你的项目.vercel.app
# DB_PATH=/data/ledger.db
# GEAR_IMG_DIR=/data/gear-images
# INVOICE_DIR=/data/invoices

# DeepSeek 发票识别（Railway 必填 DEEPSEEK_API_KEY）
# 默认：OCR 提取文字 + DeepSeek 文本解析（官方 API 即可，无需视觉模型）
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 可选：配置支持图片的视觉端点（如硅基流动）时启用
# DEEPSEEK_VISION_API_BASE=https://api.siliconflow.cn
# DEEPSEEK_VISION_MODEL=deepseek-ai/deepseek-vl2
# DEEPSEEK_VISION_API_KEY=sk-xxxxxxxx
