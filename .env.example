# 本地开发（可选，默认走 Vite 代理，无需设置）
# VITE_API_BASE=http://localhost:3001

# Railway 后端
# NODE_ENV=production
# SERVE_STATIC=false
# FRONTEND_URL=https://你的项目.vercel.app
# DB_PATH=/data/ledger.db
# GEAR_IMG_DIR=/data/gear-images
# INVOICE_DIR=/data/invoices
# FAMILY_EVENT_DIR=/data/family-events

# DeepSeek 发票识别（文本解析，官方 API 不支持图片）
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
#
# Gemini 发票识别（可选，支持图片与 PDF）
# 在 https://aistudio.google.com/apikey 申请
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite
# Mac 应用配置文件：~/Library/Application Support/Loc's Home/config.env
#
# 视觉识别（硅基流动，推荐国内使用）
# 注意：官方 DeepSeek API 不支持图片，需配置支持 VL 的兼容端点
# DEEPSEEK_VISION_API_BASE=https://api.siliconflow.cn
# DEEPSEEK_VISION_MODEL=Qwen/Qwen3.5-9B
# DEEPSEEK_VISION_API_KEY=sk-xxxxxxxx
# Mac 应用配置文件：~/Library/Application Support/Loc's Home/config.env
