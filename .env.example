# 本地开发（可选，默认走 Vite 代理，无需设置）
# VITE_API_BASE=http://localhost:3001

# Railway 后端
# NODE_ENV=production
# SERVE_STATIC=false
# FRONTEND_URL=https://你的项目.vercel.app
# DB_PATH=/data/ledger.db
# GEAR_IMG_DIR=/data/gear-images
# INVOICE_DIR=/data/invoices

# DeepSeek 发票识别
# DEEPSEEK_API_KEY=sk-xxxxxxxx          # 必填，用于文本解析（官方 api.deepseek.com）
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
#
# 视觉识别（推荐，准确度更高，且不占用服务器 OCR 内存）
# 注意：官方 DeepSeek API 目前不支持图片输入，需配置支持 VL 的兼容端点（如硅基流动）
# DEEPSEEK_VISION_API_BASE=https://api.siliconflow.cn/v1
# DEEPSEEK_VISION_MODEL=Qwen/Qwen3.5-9B
# DEEPSEEK_VISION_API_KEY=sk-xxxxxxxx   # 可与 DEEPSEEK_API_KEY 相同（同一平台时）
